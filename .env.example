# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB connection string (local, or MongoDB Atlas: mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/sks_world_school)
MONGODB_URI=mongodb://127.0.0.1:27017/sks_world_school

# Website address(es) allowed to send forms, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://skswsgnw.ac.in,https://www.skswsgnw.ac.in

# Optional: serve the website from this server too (path to the website folder).
# Leave empty if the website is hosted separately.
STATIC_DIR=../SKS-World-School-GNW-Website

# Set to 1 when running behind a proxy / load balancer (Nginx, Render, Railway, Heroku).
TRUST_PROXY=0

# Max form submissions per IP address, per form, within the window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

# Email (SMTP). Leave SMTP_HOST empty to only print emails to the console (for testing).
# Gmail / Google Workspace: host smtp.gmail.com, port 465, secure true, and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SKS World School <no-reply@skswsgnw.ac.in>"

# Who receives the alerts (comma-separated). CAREERS_EMAIL falls back to SCHOOL_EMAIL.
SCHOOL_EMAIL=contact@skswsgnw.ac.in
CAREERS_EMAIL=
